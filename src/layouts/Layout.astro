---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
}
const {
  title,
  description = 'HIPAA-compliant dental PPC management, call tracking, and education-based lead generation. Work directly with Dr. David Wank, DMD.',
  canonicalURL = Astro.url.href,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PPC Dentist</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OG -->
    <meta property="og:title" content={`${title} | PPC Dentist`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PPC Dentist" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Lora:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-light.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body class="bg-white font-sans text-brand-dark antialiased overflow-x-hidden">

    <!-- NAV -->
    <header class="sticky top-0 z-50 bg-brand-slate border-b border-white/10">
      <nav class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 shrink-0">
          <img src="/logo-light.png" alt="PPC Dentist" class="h-9 w-9 rounded-full" />
          <span class="font-display text-white text-sm font-700 tracking-widest uppercase hidden sm:block">PPC Dentist</span>
        </a>

        <!-- Desktop nav -->
        <ul class="hidden lg:flex items-center gap-1 text-sm font-medium">
          <li><a href="/" class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors">Home</a></li>
          <li><a href="/about" class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors">About</a></li>
          <li><a href="/hipaa-compliant-call-tracking" class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors">Call Tracking</a></li>

          <!-- Lead Generation dropdown -->
          <li class="relative group">
            <button class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors flex items-center gap-1">
              Lead Generation
              <svg class="w-3.5 h-3.5 opacity-60 group-hover:opacity-100 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-52 bg-white rounded-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 translate-y-1 group-hover:translate-y-0">
              <a href="/practice-health-guides" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-slate rounded-t-lg transition-colors">Practice Health Guides</a>
              <a href="/practice-health-guides-tos" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-slate rounded-b-lg transition-colors border-t border-gray-100">PHG Terms of Service</a>
            </div>
          </li>

          <li><a href="/hipaa-compliant-website-forms" class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors">Website Forms</a></li>
          <li><a href="/contact" class="text-white/80 hover:text-white px-3 py-2 rounded-md transition-colors">Contact</a></li>
        </ul>

        <!-- Phone CTA -->
        <a href="tel:9734009004" class="hidden sm:inline-flex items-center gap-2 bg-brand-red hover:bg-red-600 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
          </svg>
          (973) 400-9004
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden text-white p-2" aria-label="Toggle menu">
          <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden bg-brand-slate border-t border-white/10 px-6 pb-4">
        <ul class="flex flex-col gap-1 pt-3 text-sm font-medium">
          <li><a href="/" class="block text-white/80 hover:text-white py-2">Home</a></li>
          <li><a href="/about" class="block text-white/80 hover:text-white py-2">About</a></li>
          <li><a href="/hipaa-compliant-call-tracking" class="block text-white/80 hover:text-white py-2">Call Tracking</a></li>
          <li><a href="/practice-health-guides" class="block text-white/80 hover:text-white py-2">Practice Health Guides</a></li>
          <li><a href="/practice-health-guides-tos" class="block text-white/80 hover:text-white pl-4 py-2 text-white/60">— PHG Terms of Service</a></li>
          <li><a href="/hipaa-compliant-website-forms" class="block text-white/80 hover:text-white py-2">Website Forms</a></li>
          <li><a href="/contact" class="block text-white/80 hover:text-white py-2">Contact</a></li>
          <li class="pt-2">
            <a href="tel:9734009004" class="inline-flex items-center gap-2 bg-brand-red text-white text-sm font-semibold px-4 py-2 rounded-full">
              (973) 400-9004
            </a>
          </li>
        </ul>
      </div>
    </header>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-brand-dark text-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">

          <!-- Col 1: Brand -->
          <div>
            <img src="/logo-dark.png" alt="PPC Dentist" class="h-16 w-16 rounded-full mb-4" />
            <p class="text-white/50 text-sm leading-relaxed">HIPAA-compliant dental PPC management, call tracking, and lead generation — by a dentist who gets it.</p>
            <a href="tel:9734009004" class="mt-4 inline-block text-brand-red font-semibold text-sm hover:text-red-400 transition-colors">(973) 400-9004</a>
          </div>

          <!-- Col 2: Services -->
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-white/40 mb-4">Services</h3>
            <ul class="space-y-2 text-sm text-white/60">
              <li><a href="/hipaa-compliant-call-tracking" class="hover:text-white transition-colors">HIPAA Call Tracking</a></li>
              <li><a href="/hipaa-compliant-website-forms" class="hover:text-white transition-colors">Website Forms</a></li>
              <li><a href="/practice-health-guides" class="hover:text-white transition-colors">Practice Health Guides</a></li>
              <li><a href="/contact" class="hover:text-white transition-colors">Get Started</a></li>
            </ul>
          </div>

          <!-- Col 3: Partner logos -->
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-white/40 mb-4">Our Family</h3>
            <div class="flex items-center gap-6">
              <a href="https://shdhq.com" target="_blank" rel="noopener" class="opacity-60 hover:opacity-100 transition-opacity">
                <span class="font-display text-white font-bold text-lg tracking-wider">iSHD</span>
              </a>
              <a href="https://practicehealthguides.com" target="_blank" rel="noopener" class="opacity-60 hover:opacity-100 transition-opacity">
                <img src="https://practicehealthguides.com/logo.png" alt="Practice Health Guides" class="h-8" />
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/30">
          <span>© 2026 ppcdentist, llc. All rights reserved.</span>
          <div class="flex gap-5">
            <a href="/privacy" class="hover:text-white/60 transition-colors">Privacy Policy</a>
            <a href="/tos" class="hover:text-white/60 transition-colors">Terms of Service</a>
            <a href="/accessibility" class="hover:text-white/60 transition-colors">Accessibility</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
