---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
}
const {
  title,
  description = 'HIPAA-compliant dental PPC management, call tracking, and education-based lead generation. Work directly with Dr. David Wank, DMD.',
  canonicalURL = Astro.url.href,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PPC Dentist</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OG -->
    <meta property="og:title" content={`${title} | PPC Dentist`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PPC Dentist" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Lora:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-light.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  <body class="bg-white font-sans text-brand-dark antialiased overflow-x-hidden">

    <!-- NAV -->
    <header class="sticky top-0 z-50">

      <!-- Announcement bar -->
      <div class="bg-brand-slate py-2.5">
        <div class="max-w-5xl mx-auto px-6 lg:px-8 text-white text-xs font-semibold tracking-widest uppercase text-center">
          Exclusive Q3 Digital Audit Slots Available &mdash; 4 Remaining for September
        </div>
      </div>

      <!-- Main nav -->
      <div class="bg-white border-b border-gray-200">
        <nav class="max-w-5xl mx-auto px-6 lg:px-8 flex items-center h-20">

          <!-- Logo -->
          <a href="/" class="flex-shrink-0 mr-4">
            <img src="/pppcd-wide.png" alt="PPC Dentist" class="h-[42px] w-auto" />
          </a>

          <!-- Desktop nav (centered) -->
          <ul class="hidden lg:flex items-center gap-1 text-sm font-medium flex-1 justify-center">
            <li><a href="/about" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">About</a></li>
            <li><a href="/hipaa-compliant-call-tracking" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Call Tracking</a></li>
            <li><a href="/hipaa-compliant-website-forms" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Website Forms</a></li>
            <li><a href="/practice-health-guides" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Practice Health Guides</a></li>
            <li><a href="/contact" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Contact</a></li>
          </ul>

          <!-- 90-Day Audit CTA -->
          <a href="/contact" class="hidden sm:inline-flex items-center bg-brand-slate hover:bg-brand-dark text-white text-sm font-semibold px-5 py-2.5 rounded-md transition-colors ml-auto lg:ml-0">
            90-Day Audit
          </a>

          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="lg:hidden text-brand-slate p-2 ml-auto" aria-label="Toggle menu">
            <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200 px-6 pb-4">
        <ul class="flex flex-col gap-1 pt-3 text-sm font-medium">
          <li><a href="/about" class="block text-gray-500 hover:text-brand-dark py-2">About</a></li>
          <li><a href="/hipaa-compliant-call-tracking" class="block text-gray-500 hover:text-brand-dark py-2">Call Tracking</a></li>
          <li><a href="/hipaa-compliant-website-forms" class="block text-gray-500 hover:text-brand-dark py-2">Website Forms</a></li>
          <li><a href="/practice-health-guides" class="block text-gray-500 hover:text-brand-dark py-2">Practice Health Guides</a></li>
          <li><a href="/contact" class="block text-gray-500 hover:text-brand-dark py-2">Contact</a></li>
          <li class="pt-2">
            <a href="/contact" class="inline-flex items-center bg-brand-slate text-white text-sm font-semibold px-5 py-2.5 rounded-md">
              90-Day Audit
            </a>
          </li>
        </ul>
      </div>
    </header>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-50">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">

      <!-- CTA Card -->
      <div class="pt-16 pb-8">
        <div class="bg-brand-slate rounded-2xl px-8 py-16 text-center" style="background: linear-gradient(135deg, #0f2540 0%, #1e3a5f 100%);">
          <h2 class="font-display text-4xl md:text-5xl text-white font-semibold leading-tight mb-4">
            Ready to Grow Your<br /><em class="font-display italic font-normal">Practice?</em>
          </h2>
          <p class="text-white/60 text-base md:text-lg max-w-xl mx-auto mb-10">
            Before you spend another dime on marketing, get on a complimentary call with Dr. David Wank first so you can avoid wasting thousands of dollars on efforts that don't drive revenue.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/contact" class="bg-brand-teal hover:opacity-90 text-white font-semibold text-sm px-7 py-3.5 rounded-md transition-opacity">
              Book Now
            </a>
          </div>
        </div>
      </div>

      <!-- Footer columns -->
      <div class="py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">

          <!-- Col 1: Brand -->
          <div>
            <img src="/pppcd-wide.png" alt="PPC Dentist" class="h-10.5 w-auto mb-4" />
            <p class="text-gray-400 text-sm leading-relaxed mb-5">The premier HIPAA-compliant digital growth consultancy for dental specialists and high-volume practices.</p>
            <div class="flex items-center gap-2">
              <a href="https://shdhq.com" target="_blank" rel="noopener" aria-label="iSHD" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 text-gray-600" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 18c-4.418 0-8-3.582-8-8s3.582-8 8-8 8 3.582 8 8-3.582 8-8 8z"/></svg>
              </a>
              <a href="/contact" aria-label="Contact" class="w-8 h-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
              </a>
            </div>
          </div>

          <!-- Col 2: Solutions -->
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Solutions</h3>
            <ul class="space-y-2.5 text-sm text-gray-500">
              <li><a href="/hipaa-compliant-call-tracking" class="hover:text-brand-slate transition-colors">HIPAA Call Tracking</a></li>
              <li><a href="/hipaa-compliant-website-forms" class="hover:text-brand-slate transition-colors">Website Forms</a></li>
              <li><a href="/practice-health-guides" class="hover:text-brand-slate transition-colors">Practice Health Guides</a></li>
              <li><a href="/contact" class="hover:text-brand-slate transition-colors">PPC Management</a></li>
            </ul>
          </div>

          <!-- Col 3: Resources -->
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Resources</h3>
            <ul class="space-y-2.5 text-sm text-gray-500">
              <li><a href="/about" class="hover:text-brand-slate transition-colors">About Dr. Wank</a></li>
              <li><a href="/practice-health-guides" class="hover:text-brand-slate transition-colors">PHG Program</a></li>
              <li><a href="/privacy" class="hover:text-brand-slate transition-colors">Privacy Policy</a></li>
              <li><a href="/accessibility" class="hover:text-brand-slate transition-colors">ADA Compliance</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact -->
          <div>
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Contact</h3>
            <ul class="space-y-2 text-sm text-gray-500">
              <li>ppcdentist, llc</li>
              <li><a href="tel:9734009004" class="hover:text-brand-slate transition-colors">(973) 400-9004</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-gray-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
          <span>© 2026 ppcdentist, llc. All rights reserved.</span>
          <div class="flex gap-5">
            <a href="/privacy" class="hover:text-gray-600 transition-colors">Privacy Policy</a>
            <a href="/tos" class="hover:text-gray-600 transition-colors">Terms of Service</a>
            <a href="/accessibility" class="hover:text-gray-600 transition-colors">ADA Compliance</a>
          </div>
        </div>
      </div>
      </div><!-- /shared container -->
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
