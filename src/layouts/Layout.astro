---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
}
const {
  title,
  description = 'HIPAA-compliant dental PPC management, call tracking, and education-based lead generation. Work directly with Dr. David Wank, DMD.',
  canonicalURL = Astro.url.href,
} = Astro.props;

const GTM_ID = 'GTM-XXXXXXX';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | PPC Dentist</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OG -->
    <meta property="og:title" content={`${title} | PPC Dentist`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PPC Dentist" />


    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-light.png" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',GTM_ID);</script>
  </head>
  <body class="bg-white font-sans text-brand-dark antialiased overflow-x-hidden">

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- NAV -->
    <header class="sticky top-0 z-50">

      <!-- Announcement bar -->
      <div class="bg-brand-slate py-2.5">
        <div class="max-w-5xl mx-auto px-6 lg:px-8 text-white text-xs font-semibold tracking-widest uppercase text-center">
          Exclusive Q3 Digital Audit Slots Available &mdash; 4 Remaining for September
        </div>
      </div>

      <!-- Main nav -->
      <div class="bg-white border-b border-gray-200">
        <nav class="max-w-5xl mx-auto px-6 lg:px-8 flex items-center h-20">

          <!-- Logo -->
          <a href="/" class="shrink-0 mr-4">
            <img src="/pppcd-wide.png" alt="PPC Dentist" class="h-10.5 w-auto" />
          </a>

          <!-- Desktop nav (centered) -->
          <ul class="hidden lg:flex items-center gap-1 text-sm font-medium flex-1 justify-center">
            <li><a href="/about" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">About</a></li>
            <!-- Services dropdown -->
            <li class="relative group">
              <button class="flex items-center gap-1 text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors cursor-pointer">
                Services
                <svg class="w-3.5 h-3.5 mt-0.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <ul class="absolute left-0 top-full mt-1 w-52 bg-white border border-gray-200 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 py-1">
                <li><a href="/dental-ppc-management" class="block px-4 py-2.5 text-sm text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-colors">PPC Management</a></li>
                <li><a href="/hipaa-compliant-call-tracking" class="block px-4 py-2.5 text-sm text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-colors">Call Tracking</a></li>
                <li><a href="/hipaa-compliant-website-forms" class="block px-4 py-2.5 text-sm text-gray-600 hover:text-brand-dark hover:bg-gray-50 transition-colors">Website Forms</a></li>
              </ul>
            </li>
            <li><a href="/practice-health-guides" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Practice Health Guides</a></li>
            <li><a href="/contact" class="text-gray-500 hover:text-brand-dark px-4 py-2 border-b-2 border-transparent hover:border-brand-slate transition-colors">Contact</a></li>
          </ul>

          <!-- 90-Day Study CTA -->
          <a href="/traffic-vs-messaging-study" class="hidden sm:inline-flex items-center bg-brand-slate hover:bg-brand-dark text-white text-sm font-semibold px-5 py-2.5 rounded-md transition-colors ml-auto lg:ml-0">
            90-Day Study
          </a>

          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="lg:hidden text-brand-slate p-2 ml-auto" aria-label="Toggle menu">
            <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200 px-6 pb-4">
        <ul class="flex flex-col gap-1 pt-3 text-sm font-medium">
          <li><a href="/about" class="block text-gray-500 hover:text-brand-dark py-2">About</a></li>
          <!-- Services accordion -->
          <li>
            <button id="mobile-services-btn" class="flex items-center justify-between w-full text-gray-500 hover:text-brand-dark py-2">
              Services
              <svg id="mobile-services-icon" class="w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <ul id="mobile-services-menu" class="hidden pl-4 flex-col gap-1">
              <li><a href="/dental-ppc-management" class="block text-gray-500 hover:text-brand-dark py-2">PPC Management</a></li>
              <li><a href="/hipaa-compliant-call-tracking" class="block text-gray-500 hover:text-brand-dark py-2">Call Tracking</a></li>
              <li><a href="/hipaa-compliant-website-forms" class="block text-gray-500 hover:text-brand-dark py-2">Website Forms</a></li>
            </ul>
          </li>
          <li><a href="/practice-health-guides" class="block text-gray-500 hover:text-brand-dark py-2">Practice Health Guides</a></li>
          <li><a href="/contact" class="block text-gray-500 hover:text-brand-dark py-2">Contact</a></li>
          <li class="pt-2">
            <a href="/90-day-audit" class="inline-flex items-center bg-brand-slate text-white text-sm font-semibold px-5 py-2.5 rounded-md">
              90-Day Study
            </a>
          </li>
        </ul>
      </div>
    </header>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- PRE-FOOTER CTA -->
    <section class="bg-slate-500 py-16 px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="bg-slate-50 border-t-4 border-t-brand-red rounded-2xl px-8 md:px-12 py-12 md:py-14 shadow-xl">
          <div class="flex flex-col items-center md:flex-row md:items-center md:justify-between gap-8">
            <div class="max-w-lg text-center md:text-left">
              <p class="text-brand-red text-xs font-semibold tracking-widest uppercase mb-3">Not Sure Where to Start?</p>
              <h2 class="font-display text-2xl md:text-3xl text-brand-dark font-semibold leading-tight mb-3">
                90-Day Traffic-vs-<em class="font-display italic font-normal">Messaging Study</em>
              </h2>
              <p class="text-gray-500 text-sm md:text-base leading-relaxed">
                You wouldn't prepare teeth without knowing the problem, and you shouldn't start marketing campaign without a similarly diagnostic approach.
              </p>
            </div>
            <div class="flex flex-col gap-3 shrink-0">
              <a href="/traffic-vs-messaging-study" class="inline-flex items-center justify-center bg-brand-red hover:bg-red-700 text-white font-semibold text-sm px-7 py-3.5 rounded-md transition-colors whitespace-nowrap">
                Learn More
              </a>
              <a href="/contact" class="inline-flex items-center justify-center border border-brand-slate text-brand-slate hover:bg-brand-slate hover:text-white font-semibold text-sm px-7 py-3.5 rounded-md transition-colors whitespace-nowrap">
                Get in Touch
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-gray-50">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">

      <!-- Footer columns -->
      <div class="py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">

          <!-- Col 1: Brand -->
          <div class="text-center md:text-left">
            <img src="/pppcd-wide.png" alt="PPC Dentist" class="h-10.5 w-auto mb-4 mx-auto md:mx-0" />
            <p class="text-gray-400 text-sm leading-relaxed mb-5">The premier HIPAA-compliant digital growth consultancy for dental specialists and high-volume practices.</p>
          </div>

          <!-- Col 2: Solutions -->
          <div class="text-center md:text-left">
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Solutions</h3>
            <ul class="space-y-2.5 text-sm text-gray-500">
              <li><a href="/hipaa-compliant-call-tracking" class="hover:text-brand-slate transition-colors">HIPAA Call Tracking</a></li>
              <li><a href="/hipaa-compliant-website-forms" class="hover:text-brand-slate transition-colors">Website Forms</a></li>
              <li><a href="/practice-health-guides" class="hover:text-brand-slate transition-colors">Practice Health Guides</a></li>
              <li><a href="/dental-ppc-management" class="hover:text-brand-slate transition-colors">PPC Management</a></li>
            </ul>
          </div>

          <!-- Col 3: Resources -->
          <div class="text-center md:text-left">
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Resources</h3>
            <ul class="space-y-2.5 text-sm text-gray-500">
              <li><a href="/about" class="hover:text-brand-slate transition-colors">About PPCD</a></li>
              <li><a href="/traffic-vs-messaging-study" class="hover:text-brand-slate transition-colors">Diagnostic Study</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact -->
          <div class="text-center md:text-left">
            <h3 class="text-xs font-semibold tracking-widest uppercase text-gray-400 mb-4">Contact</h3>
            <ul class="space-y-2 text-sm text-gray-500">
              <li>PPC Dentist, LLC</li>
              <li><a href="tel:9734009004" class="hover:text-brand-slate transition-colors">(973) 400-9004</a></li>
              <li><a href="/contact" class="hover:text-brand-slate transition-colors">Contact Us</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="border-t border-gray-200 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
          <span>© 2026 ppcdentist, llc. All rights reserved.</span>
          <div class="flex gap-5">
            <a href="/privacy" class="hover:text-gray-600 transition-colors">Privacy Policy</a>
            <a href="/tos" class="hover:text-gray-600 transition-colors">Terms of Service</a>
            <a href="/accessibility" class="hover:text-gray-600 transition-colors">Accessibility</a>
          </div>
        </div>
      </div>
      </div><!-- /shared container -->
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });

      const servicesBtn = document.getElementById('mobile-services-btn');
      const servicesMenu = document.getElementById('mobile-services-menu');
      const servicesIcon = document.getElementById('mobile-services-icon');
      servicesBtn?.addEventListener('click', () => {
        servicesMenu?.classList.toggle('hidden');
        servicesMenu?.classList.toggle('flex');
        servicesIcon?.classList.toggle('rotate-180');
      });
    </script>
  </body>
</html>
