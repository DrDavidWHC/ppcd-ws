---
/**
 * BentoFeature
 * Centered heading + bento grid: one large dark card (left) + one tall light card (right) + three small cards below.
 *
 * Props:
 *   heading       – main heading text
 *   subheading    – subtitle below heading
 *   primaryBadge  – uppercase badge on the dark card
 *   primaryTitle  – headline on the dark card
 *   primaryBody   – body text on the dark card
 *   primaryStats  – array of { value, label } shown as inline stats on the dark card
 *   secondaryIcon – SVG string for the tall light card icon (optional)
 *   secondaryTitle – title on the tall light card
 *   secondaryBody  – body on the tall light card
 *   secondaryList  – array of strings for bullet list on the tall light card
 *   cards          – array of { icon (SVG string), title, body } for the three bottom cards
 */
export interface Props {
  heading: string;
  subheading?: string;
  primaryBadge: string;
  primaryTitle: string;
  primaryBody: string;
  primaryStats?: { value: string; label: string }[];
  secondaryTitle: string;
  secondaryBody: string;
  secondaryList?: string[];
  cards: { title: string; body: string }[];
}

const {
  heading,
  subheading,
  primaryBadge,
  primaryTitle,
  primaryBody,
  primaryStats = [],
  secondaryTitle,
  secondaryBody,
  secondaryList = [],
  cards,
} = Astro.props;
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Heading -->
    <div class="text-center mb-14">
      <h2 class="font-display text-4xl lg:text-5xl font-semibold text-brand-dark mb-4">{heading}</h2>
      {subheading && <p class="text-gray-500 text-base max-w-xl mx-auto">{subheading}</p>}
    </div>

    <!-- Top row: large dark card + tall light card -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-4">

      <!-- Dark card (spans 3 cols) -->
      <div class="lg:col-span-3 bg-brand-slate rounded-2xl p-8 relative overflow-hidden">
        <div class="absolute top-6 right-6 opacity-10">
          <svg class="w-28 h-28 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        </div>
        <span class="inline-block text-xs font-semibold tracking-widest uppercase text-white/50 border border-white/20 rounded px-2 py-1 mb-6">{primaryBadge}</span>
        <h3 class="font-display text-3xl lg:text-4xl font-semibold text-white leading-tight mb-5 max-w-sm">{primaryTitle}</h3>
        <p class="text-white/60 text-sm leading-relaxed mb-8 max-w-sm">{primaryBody}</p>
        {primaryStats.length > 0 && (
          <div class="border-t border-white/10 pt-6 flex items-center gap-8">
            {primaryStats.map(s => (
              <div>
                <div class="text-white font-bold text-lg">{s.value}</div>
                <div class="text-white/40 text-xs tracking-widest uppercase">{s.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Light card (spans 2 cols) -->
      <div class="lg:col-span-2 bg-blue-50 rounded-2xl p-8">
        <div class="w-10 h-10 rounded-lg bg-brand-teal/15 flex items-center justify-center mb-6">
          <svg class="w-5 h-5 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
        </div>
        <h3 class="font-display text-2xl font-semibold text-brand-dark mb-4">{secondaryTitle}</h3>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">{secondaryBody}</p>
        {secondaryList.length > 0 && (
          <ul class="space-y-2">
            {secondaryList.map(item => (
              <li class="flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-brand-dark">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <!-- Bottom row: three cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {cards.map(card => (
        <div class="bg-white rounded-2xl p-7 border border-gray-100">
          <div class="w-9 h-9 rounded-lg bg-brand-teal/10 flex items-center justify-center mb-5">
            <svg class="w-4 h-4 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <h4 class="font-semibold text-brand-dark mb-2">{card.title}</h4>
          <p class="text-gray-500 text-sm leading-relaxed">{card.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>
