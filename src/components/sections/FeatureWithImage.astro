---
/**
 * FeatureWithImage
 * Two-column: left = heading (bold + teal italic), body, icon-list; right = large dark image card.
 *
 * Props:
 *   heading       – first line (bold)
 *   headingItalic – second line (teal italic serif)
 *   body          – paragraph below heading
 *   items         – array of { title, body, color?: 'red'|'teal' } icon-list items
 *   image?        – { src, alt } for the right-side image (dark card if omitted)
 */
export interface Props {
  heading: string;
  headingItalic: string;
  body: string;
  items: { title: string; body: string; color?: 'red' | 'teal' }[];
  image?: { src: string; alt: string };
}

const { heading, headingItalic, body, items, image } = Astro.props;
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left -->
      <div>
        <h2 class="font-display text-4xl lg:text-5xl font-semibold text-brand-dark leading-tight mb-6">
          {heading}<br />
          <em class="font-display italic font-normal text-brand-teal">{headingItalic}</em>
        </h2>
        <p class="text-gray-500 text-base leading-relaxed mb-10">{body}</p>
        <ul class="space-y-6">
          {items.map(item => (
            <li class="flex items-start gap-4">
              <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 ${item.color === 'red' ? 'bg-red-50' : 'bg-brand-teal/10'}`}>
                {item.color === 'red'
                  ? <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                  : <svg class="w-4 h-4 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                }
              </div>
              <div>
                <h4 class="font-semibold text-brand-dark mb-1">{item.title}</h4>
                <p class="text-gray-500 text-sm leading-relaxed">{item.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: image or dark card -->
      <div class="rounded-2xl overflow-hidden bg-brand-dark aspect-square lg:aspect-auto lg:h-[480px]">
        {image
          ? <img src={image.src} alt={image.alt} class="w-full h-full object-cover" />
          : <div class="w-full h-full flex items-center justify-center p-10">
              <div class="text-center">
                <div class="w-32 h-32 rounded-2xl bg-white/5 mx-auto mb-6"></div>
                <p class="text-white/20 text-xs tracking-widest uppercase">Image Placeholder</p>
              </div>
            </div>
        }
      </div>

    </div>
  </div>
</section>
