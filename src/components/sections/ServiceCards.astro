---
/**
 * ServiceCards
 * Centered badge + heading, then 3 equal white cards with colored top border, icon, title, body, link.
 *
 * Props:
 *   badge   – small uppercase teal badge
 *   heading – section heading
 *   cards   – array of 3 { title, body, link: { label, href }, color?: 'red'|'teal'|'teal-light' }
 */
export interface Props {
  badge: string;
  heading: string;
  cards: {
    title: string;
    body: string;
    link: { label: string; href: string };
    color?: 'red' | 'teal' | 'teal-light';
  }[];
}

const { badge, heading, cards } = Astro.props;

const colorMap = {
  red:        { border: 'border-t-brand-red',  icon: 'bg-red-50 text-brand-red',   link: 'text-brand-red' },
  teal:       { border: 'border-t-brand-teal', icon: 'bg-brand-teal/10 text-brand-teal', link: 'text-brand-teal' },
  'teal-light': { border: 'border-t-brand-teal/40', icon: 'bg-brand-teal/10 text-brand-teal', link: 'text-brand-teal/70' },
};

const icons = [
  `<path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
];
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Heading -->
    <div class="text-center mb-12">
      <span class="text-brand-teal text-xs font-semibold tracking-widest uppercase mb-3 block">{badge}</span>
      <h2 class="font-display text-4xl lg:text-5xl font-semibold text-brand-dark">{heading}</h2>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {cards.map((card, i) => {
        const c = colorMap[card.color ?? 'teal'];
        return (
          <div class={`bg-white rounded-2xl p-8 border border-gray-100 border-t-4 ${c.border} flex flex-col`}>
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center mb-6 ${c.icon}`}>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={icons[i % icons.length]}></svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-brand-dark mb-3">{card.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed flex-1">{card.body}</p>
            <a href={card.link.href} class={`mt-6 font-semibold text-sm inline-flex items-center gap-1 ${c.link} hover:opacity-80 transition-opacity`}>
              {card.link.label} &rarr;
            </a>
          </div>
        );
      })}
    </div>

  </div>
</section>
