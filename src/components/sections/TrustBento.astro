---
/**
 * TrustBento
 * Centered badge + heading, then a 3-col card row + wide dark banner row.
 *
 * Props:
 *   badge        – small uppercase teal badge text
 *   heading      – section heading
 *   cards        – array of 3 card objects:
 *     {
 *       title:    string
 *       body:     string
 *       accent?:  'teal' | 'default'   – teal bg for the featured card
 *       badge?:   string               – small pill at the bottom
 *       bullets?: string[]             – checklist items at the bottom
 *       avatars?: string[]             – array of image srcs for avatar stack
 *     }
 *   banner: {
 *     title:   string
 *     body:    string
 *     stat:    string   – large number/text (e.g. "60")
 *     statLabel: string
 *     ctaLabel: string
 *     ctaHref:  string
 *   }
 */
export interface Props {
  badge: string;
  heading: string;
  cards: {
    title: string;
    body: string;
    accent?: 'teal' | 'default';
    badge?: string;
    bullets?: string[];
    avatars?: string[];
  }[];
  banner: {
    title: string;
    body: string;
    stat: string;
    statLabel: string;
    ctaLabel: string;
    ctaHref: string;
  };
}

const { badge, heading, cards, banner } = Astro.props;
---

<section class="bg-gray-50 py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <!-- Heading -->
    <div class="text-center mb-12">
      <span class="text-brand-teal text-xs font-semibold tracking-widest uppercase mb-3 block">{badge}</span>
      <h2 class="font-display text-4xl lg:text-5xl font-semibold text-brand-dark">{heading}</h2>
    </div>

    <!-- Top: 3 cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
      {cards.map(card => (
        <div class={`rounded-2xl p-7 flex flex-col justify-between ${card.accent === 'teal' ? 'bg-brand-teal/20' : 'bg-white border border-gray-100'}`}>
          <div>
            <div class={`w-9 h-9 rounded-lg flex items-center justify-center mb-5 ${card.accent === 'teal' ? 'bg-brand-teal/20' : 'bg-brand-teal/10'}`}>
              <svg class="w-4 h-4 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-brand-dark mb-3">{card.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{card.body}</p>
          </div>
          <div class="mt-6">
            {card.badge && (
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-widest uppercase text-brand-teal">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal"></span>
                {card.badge}
              </span>
            )}
            {card.bullets && card.bullets.length > 0 && (
              <ul class="space-y-1.5">
                {card.bullets.map(b => (
                  <li class="flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-brand-teal">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    {b}
                  </li>
                ))}
              </ul>
            )}
            {card.avatars && card.avatars.length > 0 && (
              <div class="flex -space-x-2">
                {card.avatars.map(src => (
                  <img src={src} class="w-8 h-8 rounded-full border-2 border-white object-cover" alt="" />
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom: dark banner -->
    <div class="bg-brand-slate rounded-2xl p-8 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
      <div class="lg:col-span-1">
        <h3 class="font-display text-2xl font-semibold text-white mb-2">{banner.title}</h3>
        <p class="text-white/60 text-sm leading-relaxed">{banner.body}</p>
      </div>
      <div class="flex items-center gap-4 lg:col-span-2 lg:justify-end">
        <div class="bg-white/10 rounded-xl px-6 py-4 text-center">
          <div class="font-display text-3xl font-semibold text-white">{banner.stat}</div>
          <div class="text-white/40 text-xs tracking-widest uppercase mt-1">{banner.statLabel}</div>
        </div>
        <a href={banner.ctaHref} class="bg-brand-teal hover:opacity-90 text-white font-semibold text-sm px-6 py-4 rounded-xl transition-opacity flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          {banner.ctaLabel}
        </a>
      </div>
    </div>

  </div>
</section>
