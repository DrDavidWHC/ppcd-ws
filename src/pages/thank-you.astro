---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank You" description="Thank you for contacting PPC Dentist. We will be in touch within one business day.">

  <section class="bg-gray-50 py-32 lg:py-40 min-h-[60vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 lg:px-8 text-center">

      <div class="w-16 h-16 rounded-full bg-teal-50 flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <p class="text-brand-red text-xs font-semibold tracking-widest uppercase mb-4">Message Received</p>

      <h1 class="font-display text-4xl lg:text-5xl font-semibold text-brand-dark leading-tight mb-6">
        Thank You for<br /><em class="font-display italic font-normal">Reaching Out</em>
      </h1>

      <p class="text-gray-600 text-lg leading-relaxed mb-10">
        Thank you for submitting your contact request. We will be in touch within 24 hours on the next business day.
      </p>

      <a href="/" class="inline-flex items-center justify-center bg-brand-slate hover:bg-brand-dark text-white font-semibold text-sm px-8 py-3.5 rounded-md transition-colors">
        Back to Home
      </a>

    </div>
  </section>

</Layout>
