---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found">
  <section class="bg-brand-slate py-32 text-center">
    <div class="max-w-xl mx-auto px-6">
      <div class="font-display text-8xl font-800 text-white/10 mb-4">404</div>
      <h1 class="font-display text-3xl font-700 text-white mb-4">Page Not Found</h1>
      <p class="text-white/60 mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-brand-red hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-full transition-colors text-sm">
        Back to Home
      </a>
    </div>
  </section>
</Layout>
