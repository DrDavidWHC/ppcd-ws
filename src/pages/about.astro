---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" description="Dr. David Wank, DMD — Harvard-trained dentist, Google Ads certified, and founder of PPC Dentist and Short Hills Design LLC.">

  <!-- PAGE HERO -->
  <section class="bg-gray-50 py-16 lg:py-24">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center bg-brand-teal/10 text-brand-teal text-xs font-semibold tracking-widest uppercase px-3 py-1.5 rounded-full mb-6">Who We Are</span>
          <h1 class="font-display text-5xl lg:text-6xl font-semibold text-brand-dark leading-tight mb-6">
            About<br /><em class="font-display italic font-normal">PPC Dentist</em>
          </h1>
          <p class="text-gray-500 text-base leading-relaxed mb-8 max-w-md">
            Work with a Harvard-trained DMD who combines the clinical mind of a dentist with the precision of a performance marketer. At PPCD, we don't guess — we measure.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-brand-slate hover:bg-brand-dark text-white font-semibold text-sm px-6 py-3 rounded-md transition-colors">
            Work With Us &rarr;
          </a>
        </div>
        <div class="relative flex items-center justify-center">
          <div class="w-4/5 bg-white p-[8%] rounded-2xl shadow-sm">
            <img src="/dr-david-wank-300x300.jpg" alt="Dr. David Wank, DMD" class="w-full h-full object-cover rounded-xl" />
            <p class="text-center text-sm font-semibold text-gray-400 mt-3">Dr. David Wank</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

        <div>
          <p class="text-brand-red text-xs font-semibold tracking-widest uppercase mb-3">Founder & CEO</p>
          <h2 class="font-display text-3xl lg:text-4xl font-700 text-brand-dark mb-6">Dr. David Wank</h2>
          <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
            <p>
              As a practicing general dentist with a DMD from Harvard, and the founder and CEO of Short Hills Design and PPCDentist, LLC, Dr. David Wank combines the skills of a dentist with the mind of a marketer like nobody else can.
            </p>
            <p>
              Dr. Wank holds his Google Analytics IQ (GAIQ), Google Analytics 4, and Google Ads Search Certifications. He built PPC Dentist out of a simple frustration: dental practices were spending thousands on marketing agencies that didn't understand dentistry, and dental patients were being acquired with a sledgehammer approach that wasted money and ignored the patient journey.
            </p>
            <p>
              PPC Dentist was created to bridge that gap — bringing together the clinical knowledge of a dentist and the technical precision of a certified digital marketer to deliver campaigns that actually produce new patients.
            </p>
          </div>

          <div class="flex flex-wrap gap-3 mt-8">
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              DMD, Harvard School of Dental Medicine
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Google Ads Search Certified
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Google Analytics IQ (GAIQ)
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              GA4 Certified
            </span>
          </div>

          <a href="/contact" class="mt-8 inline-flex items-center gap-2 bg-brand-red hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-full transition-colors text-sm">
            Get on the Phone With Dr. Wank
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
        </div>

        <!-- Companies -->
        <div class="space-y-6">
          <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100">
            <h3 class="font-display text-lg font-700 text-brand-dark mb-2">PPC Dentist, LLC</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Google Ads management, HIPAA-compliant call tracking, website forms, and education-based lead generation for dental practices.</p>
          </div>
          <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100">
            <h3 class="font-display text-lg font-700 text-brand-dark mb-2">Short Hills Design, LLC</h3>
            <p class="text-sm text-gray-600 leading-relaxed">A full-service digital agency specializing in website design, hosting, and digital marketing for dental practices. Managing 70+ client websites nationwide.</p>
            <a href="https://shorthillsdesign.com" class="mt-3 inline-block text-brand-slate text-sm font-semibold">shorthillsdesign.com</a>
          </div>
          <div class="bg-gray-50 rounded-2xl p-7 border border-gray-100">
            <h3 class="font-display text-lg font-700 text-brand-dark mb-2">Learn the Process</h3>
            <p class="text-sm text-gray-600 leading-relaxed">A collection of Dr. Wank's training courses and educational material including "The Dental Website Owner's Manual".</p>
            <a href="https://www.learntheprocess.com" target="_blank" rel="noopener" class="mt-3 inline-block text-brand-slate text-sm font-semibold">learntheprocess.com</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
