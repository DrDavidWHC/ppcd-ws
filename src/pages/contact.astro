---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Schedule a complimentary consultation with Dr. David Wank. Call (973) 400-9004 or complete the form below.">

  <section class="bg-brand-slate py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand-teal text-xs font-semibold tracking-widest uppercase mb-3">Let's Talk</p>
      <h1 class="font-display text-4xl lg:text-5xl font-800 text-white">Get in Touch</h1>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Left: Info -->
        <div>
          <h2 class="font-display text-2xl font-700 text-brand-dark mb-4">Schedule a Free Consultation</h2>
          <p class="text-gray-600 leading-relaxed mb-8">Submit your information below and we will be in touch to schedule your complimentary consultation with Dr. Wank.</p>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-1">Phone</div>
                <a href="tel:9734009004" class="text-brand-dark font-semibold hover:text-brand-red transition-colors">(973) 400-9004</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-1">Email</div>
                <a href="mailto:david@ppcdentist.com" class="text-brand-dark font-semibold hover:text-brand-red transition-colors">david@ppcdentist.com</a>
              </div>
            </div>
          </div>

          <div class="mt-10 bg-gray-50 rounded-2xl p-7 border border-gray-100">
            <p class="text-sm text-gray-600 leading-relaxed italic">"I take every call personally. When you call PPC Dentist, you're talking to a dentist who understands your practice — not a salesperson reading from a script."</p>
            <p class="text-xs text-gray-400 mt-3 font-semibold">— Dr. David Wank, DMD</p>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <form
            action={`mailto:david@ppcdentist.com?subject=New Contact Form Submission`}
            method="get"
            enctype="text/plain"
            class="space-y-5"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-gray-700 mb-1.5">Your Name *</label>
                <input type="text" id="name" name="name" required placeholder="Dr. Jane Smith" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold text-gray-700 mb-1.5">Email Address *</label>
                <input type="email" id="email" name="email" required placeholder="jane@yourpractice.com" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
              </div>
            </div>
            <div>
              <label for="practice" class="block text-xs font-semibold text-gray-700 mb-1.5">Practice Name</label>
              <input type="text" id="practice" name="practice" placeholder="Smith Family Dentistry" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
            </div>
            <div>
              <label for="phone" class="block text-xs font-semibold text-gray-700 mb-1.5">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
            </div>
            <div>
              <label for="message" class="block text-xs font-semibold text-gray-700 mb-1.5">How Can We Help?</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us a bit about your practice and what you're looking to achieve..." class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white resize-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-brand-red hover:bg-red-600 text-white font-semibold py-3 rounded-full transition-colors text-sm">
              Send Message
            </button>
            <p class="text-xs text-gray-400 text-center">We respond within 1 business day.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>
