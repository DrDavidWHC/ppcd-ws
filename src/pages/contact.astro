---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Schedule a complimentary consultation with Dr. David Wank. Call (973) 400-9004 or complete the form below.">

  <section class="bg-gray-50 py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <span class="inline-flex items-center bg-brand-teal/10 text-brand-teal text-xs font-semibold tracking-widest uppercase px-3 py-1.5 rounded-full mb-6">Let's Talk</span>
      <h1 class="font-display text-5xl lg:text-6xl font-semibold text-brand-dark leading-tight">
        Get in<br /><em class="font-display italic font-normal">Touch</em>
      </h1>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Left: Info -->
        <div>
          <h2 class="font-display text-2xl font-700 text-brand-dark mb-4">Schedule a Free Consultation</h2>
          <p class="text-gray-600 leading-relaxed mb-8">Submit your information below and we will be in touch to schedule your complimentary consultation with Dr. Wank.</p>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-1">Phone</div>
                <a href="tel:9734009004" class="text-brand-dark font-semibold hover:text-brand-red transition-colors">(973) 400-9004</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-1">Email</div>
                <a href="mailto:davidw@ppcdentist.com" class="text-brand-dark font-semibold hover:text-brand-red transition-colors">davidw[at]ppcdentist.com</a>
              </div>
            </div>
          </div>

          <div class="mt-10 bg-gray-50 rounded-2xl p-7 border border-gray-100">
            <p class="text-sm text-gray-600 leading-relaxed italic">"I take every call personally. When you call PPC Dentist, you're talking to a dentist who understands your practice — not a salesperson reading from a script."</p>
            <p class="text-xs text-gray-400 mt-3 font-semibold">— Dr. David Wank</p>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <form id="contact-form" action="https://formspree.io/f/xlgzqoae" method="POST" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-gray-700 mb-1.5">Your Name *</label>
                <input type="text" id="name" name="name" placeholder="Dr. Jane Smith" required aria-describedby="name-error" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
                <p id="name-error" class="text-xs text-red-500 mt-1 hidden" role="alert"></p>
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold text-gray-700 mb-1.5">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="jane@yourpractice.com" required aria-describedby="email-error" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
                <p id="email-error" class="text-xs text-red-500 mt-1 hidden" role="alert"></p>
              </div>
            </div>
            <div>
              <label for="practice" class="block text-xs font-semibold text-gray-700 mb-1.5">Practice Name</label>
              <input type="text" id="practice" name="practice" placeholder="Smith Family Dentistry" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
            </div>
            <div>
              <label for="phone" class="block text-xs font-semibold text-gray-700 mb-1.5">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" aria-describedby="phone-error" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white" />
              <p id="phone-error" class="text-xs text-red-500 mt-1 hidden" role="alert"></p>
            </div>
            <div>
              <label for="message" class="block text-xs font-semibold text-gray-700 mb-1.5">How Can We Help? *</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us a bit about your practice and what you're looking to achieve..." required aria-describedby="message-error" class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-slate focus:border-transparent bg-white resize-none"></textarea>
              <p id="message-error" class="text-xs text-red-500 mt-1 hidden" role="alert"></p>
            </div>
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
            <button type="submit" id="submit-btn" class="w-full bg-brand-red hover:bg-red-600 text-white font-semibold py-3 rounded-full transition-colors text-sm">
              Send Message
            </button>
            <p class="text-xs text-gray-400 text-center">We respond within 1 business day.</p>
          </form>

          <!-- Error state -->
          <p id="form-error" class="hidden text-sm text-red-500 text-center mt-3">Something went wrong. Please try again or call us at <a href="tel:9734009004" class="underline">(973) 400-9004</a>.</p>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
const errorEl = document.getElementById('form-error') as HTMLElement;

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  let submitting = false;

  function showFieldError(id: string, msg: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
    const hint = document.getElementById(`${id}-error`) as HTMLElement;
    el.classList.add('border-red-400', 'ring-1', 'ring-red-400');
    el.classList.remove('border-gray-200');
    el.setAttribute('aria-invalid', 'true');
    hint.textContent = msg;
    hint.classList.remove('hidden');
  }

  function clearFieldError(id: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
    const hint = document.getElementById(`${id}-error`) as HTMLElement;
    el.classList.remove('border-red-400', 'ring-1', 'ring-red-400');
    el.classList.add('border-gray-200');
    el.removeAttribute('aria-invalid');
    hint.textContent = '';
    hint.classList.add('hidden');
  }

  function validateField(id: string): boolean {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
    const val = el.value.trim();

    if (id === 'name') {
      if (!val) { showFieldError('name', 'Please enter your name.'); return false; }
    }
    if (id === 'email') {
      if (!val) { showFieldError('email', 'Please enter your email address.'); return false; }
      if (!emailRe.test(val)) { showFieldError('email', 'Please enter a valid email address.'); return false; }
    }
    if (id === 'phone' && val) {
      const digits = val.replace(/\D/g, '');
      if (digits.length < 10 || digits.length > 11) {
        showFieldError('phone', 'Please enter a valid 10-digit phone number.');
        return false;
      }
    }
    if (id === 'message') {
      if (!val) { showFieldError('message', 'Please tell us how we can help.'); return false; }
    }

    clearFieldError(id);
    return true;
  }

  function validate(): boolean {
    const results = ['name', 'email', 'phone', 'message'].map(validateField);
    return results.every(Boolean);
  }

  (['name', 'email', 'phone', 'message'] as const).forEach((id) => {
    const el = document.getElementById(id);
    el?.addEventListener('input', () => validateField(id));
    el?.addEventListener('blur', () => validateField(id));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitting) return;

    if (!validate()) {
      const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
      firstInvalid?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      firstInvalid?.focus({ preventScroll: true });
      return;
    }

    submitting = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing…';
    errorEl.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        window.location.href = '/thank-you';
      } else {
        throw new Error();
      }
    } catch {
      errorEl.classList.remove('hidden');
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    } finally {
      submitting = false;
    }
  });
</script>
