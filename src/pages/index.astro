---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lead Generation You Can Actually Trust" description="We help dental practices get 5–10 new patients per month using HIPAA-compliant PPC, call tracking, and education-based drip marketing.">

  <!-- HERO -->
  <section class="bg-brand-slate relative overflow-hidden">
    <!-- Background accents -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-red/10 rounded-full -translate-y-1/2 translate-x-1/3 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-teal/10 rounded-full translate-y-1/2 -translate-x-1/3 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="text-brand-teal text-xs font-semibold tracking-widest uppercase mb-4">Dental PPC Management</p>
        <h1 class="font-display text-4xl lg:text-6xl font-800 text-white leading-tight mb-6">
          Lead Generation<br />
          <span class="text-brand-red">You Can Actually</span><br />
          Trust.
        </h1>
        <p class="text-white/70 text-lg leading-relaxed mb-8 max-w-xl">
          We help dental practices get 5–10 new patients per month using HIPAA-compliant PPC, call tracking, and education-based drip marketing.
        </p>
        <div class="flex flex-wrap gap-4 items-center">
          <a href="/contact" class="inline-flex items-center gap-2 bg-brand-red hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-full transition-colors text-sm">
            Get Started
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="/about" class="text-white/60 hover:text-white text-sm font-medium transition-colors">
            Meet Dr. Wank →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE CARDS -->
  <section class="bg-gray-50 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-brand-slate text-xs font-semibold tracking-widest uppercase mb-3 text-center">What We Do</p>
      <h2 class="font-display text-3xl lg:text-4xl font-700 text-brand-dark text-center mb-12">Everything Your Practice Needs to Grow</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-red shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">PPC Management</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Google Ads campaigns built for dentists. No fluff, no guessing — just new patients.</p>
          <a href="/contact" class="mt-5 inline-block text-brand-red text-sm font-semibold hover:text-red-700 transition-colors">Get started →</a>
        </div>

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-teal shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">HIPAA Call Tracking</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Know which efforts drive real appointments — without compromising patient privacy.</p>
          <a href="/hipaa-compliant-call-tracking" class="mt-5 inline-block text-brand-teal text-sm font-semibold hover:text-teal-700 transition-colors">Learn more →</a>
        </div>

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-lime shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">Practice Health Guides</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Email-based lead generation that educates, builds trust, and converts — without discounts.</p>
          <a href="/practice-health-guides" class="mt-5 inline-block text-brand-lime text-sm font-semibold hover:text-green-700 transition-colors">Learn more →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- MEET DR. WANK -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Text -->
        <div>
          <p class="text-brand-red text-xs font-semibold tracking-widest uppercase mb-3">Founder & CEO, Short Hills Design LLC</p>
          <h2 class="font-display text-3xl lg:text-4xl font-700 text-brand-dark mb-6">Meet Dr. David Wank</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            As a practicing general dentist with a DMD from Harvard, and the founder and COO of Short Hills Design and PPCDentist, LLC, Dr. David Wank combines the skills of a dentist with the mind of a marketer like nobody else can.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Dr. Wank holds his Google Analytics IQ, Google Analytics 4, and Google Ads Search Certifications — and has spent years helping dental practices grow through data-driven digital marketing.
          </p>
          <div class="flex flex-wrap gap-3 mb-8">
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              DMD, Harvard
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Google Ads Certified
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              GA4 Certified
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 text-xs font-semibold px-3 py-1.5 rounded-full">
              <svg class="w-3 h-3 text-brand-lime" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              HIPAA Compliant
            </span>
          </div>
          <a href="/contact" class="inline-flex items-center gap-2 bg-brand-slate hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-full transition-colors text-sm">
            Get on the Phone With Him
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
        </div>

        <!-- Stats card -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <div class="grid grid-cols-2 gap-6 mb-8">
            <div class="bg-white rounded-xl p-5 border border-gray-100">
              <div class="font-display text-3xl font-800 text-brand-red mb-1">5–10</div>
              <div class="text-xs text-gray-500 font-medium">New patients/month</div>
            </div>
            <div class="bg-white rounded-xl p-5 border border-gray-100">
              <div class="font-display text-3xl font-800 text-brand-slate mb-1">60</div>
              <div class="text-xs text-gray-500 font-medium">Days or fewer</div>
            </div>
            <div class="bg-white rounded-xl p-5 border border-gray-100">
              <div class="font-display text-3xl font-800 text-brand-teal mb-1">100%</div>
              <div class="text-xs text-gray-500 font-medium">HIPAA compliant</div>
            </div>
            <div class="bg-white rounded-xl p-5 border border-gray-100">
              <div class="font-display text-3xl font-800 text-brand-lime mb-1">DMD</div>
              <div class="text-xs text-gray-500 font-medium">Harvard trained</div>
            </div>
          </div>
          <div class="bg-brand-slate rounded-xl p-5 text-white">
            <p class="text-sm leading-relaxed text-white/80 italic">"You wouldn't let a marketer perform your root canal. Why let one run your dental marketing?"</p>
            <p class="text-xs text-white/50 mt-3 font-semibold">— Dr. David Wank, DMD</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="bg-brand-red py-14">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-700 text-white mb-4">Ready to Grow Your Practice?</h2>
      <p class="text-white/80 mb-8 max-w-xl mx-auto">Schedule a complimentary consultation with Dr. Wank and find out exactly how we can help your practice.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center gap-2 bg-white text-brand-red font-semibold px-6 py-3 rounded-full hover:bg-red-50 transition-colors text-sm">
          Schedule a Free Consultation
        </a>
        <a href="tel:9734009004" class="inline-flex items-center gap-2 border border-white/40 text-white font-semibold px-6 py-3 rounded-full hover:bg-white/10 transition-colors text-sm">
          (973) 400-9004
        </a>
      </div>
    </div>
  </section>

</Layout>
