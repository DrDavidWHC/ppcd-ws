---
import Layout from '../layouts/Layout.astro';
import NumberedBento from '../components/sections/NumberedBento.astro';
---
<Layout title="Lead Generation You Can Actually Trust" description="We help dental practices get 5–10 new patients per month using HIPAA-compliant PPC, call tracking, and education-based drip marketing.">

  <!-- HERO -->
  <section class="bg-white py-20 lg:py-28">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: text -->
        <div>
          <span class="inline-flex items-center gap-1.5 text-brand-teal text-xs font-semibold tracking-widest uppercase mb-6">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 22l-2.09-10.26L4 10l5.91-1.74z"/></svg>
            Data-Driven Marketing
          </span>
          <h1 class="font-display text-5xl lg:text-6xl font-semibold text-brand-dark leading-tight mb-6">
            Lead Generation<br />
            <em class="font-display italic font-normal">You Can Actually Trust</em>
          </h1>
          <p class="text-gray-500 text-base leading-relaxed mb-8 max-w-md">
            We don't just generate clicks. We build high-authority digital ecosystems for dentists who demand precision in their patient acquisition.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/about" class="inline-flex items-center bg-brand-slate hover:bg-brand-dark text-white font-semibold text-sm px-6 py-3 rounded-md transition-colors">
              Meet Dr. David Wank
            </a>
            <a href="/traffic-vs-messaging-study" class="inline-flex items-center border border-brand-slate text-brand-slate hover:bg-brand-slate hover:text-white font-semibold text-sm px-6 py-3 rounded-md transition-colors">
              Explore Our 90-Day Study
            </a>
          </div>
        </div>

        <!-- Right: image -->
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100">
            <img src="/g_operatory-ppcd.jpg" alt="Modern dental operatory" class="w-full h-full object-cover" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SERVICE CARDS -->
  <section class="bg-gray-50 py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-brand-slate text-xs font-semibold tracking-widest uppercase mb-3 text-center">What We Do</p>
      <h2 class="font-display text-3xl lg:text-4xl font-700 text-brand-dark text-center mb-12">Everything Your Practice Needs to Grow</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-teal shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">HIPAA Compliant Call Tracking</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Know which efforts drive real appointments — without compromising patient privacy.</p>
          <a href="/hipaa-compliant-call-tracking" class="mt-5 inline-block text-brand-teal text-sm font-semibold hover:text-teal-700 transition-colors">Learn more →</a>
        </div>

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-blue shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">Lead Generation for Invisalign, Implants and Aligners</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Our "Practice Health Guides" is an email-based lead generation approach that educates, builds trust, and converts — without the pressure tactics used by many other agencies.</p>
          <a href="/practice-health-guides" class="mt-5 inline-block text-brand-blue text-sm font-semibold hover:opacity-70 transition-opacity">Learn more →</a>
        </div>

        <div class="bg-white rounded-xl p-7 border border-gray-100 border-t-4 border-t-brand-lime shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-brand-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="font-display text-lg font-700 text-brand-dark mb-2">PPC Management</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Google Ads campaigns built for dentists. No fluff, no guessing — just new patients.</p>
          <a href="/dental-ppc-management" class="mt-5 inline-block text-brand-lime text-sm font-semibold hover:text-green-700 transition-colors">Learn more →</a>
        </div>

      </div>
    </div>
  </section>

  <NumberedBento
    heading="The Big Picture"
    headingItalic="for Your Practice"
    bg="bg-white"
    headingSize="text-3xl lg:text-4xl"
    centered
    items={[
      { title: "Tactical Myopia", body: "Most agencies sell 'clicks.' We build clinical authority. If your marketing doesn't mirror the sophistication of your practice, you're losing high-value patients." },
      { title: "The \"Commodity\" Trap", body: "Specialists aren't generalists. When an agency treats a dental client like a local pizza shop, they destroy your perceived value.", featured: true, bullets: ["Zero Generic Templates", "Clinical Content Precision"] },
      { title: "Metrics Without Meaning", body: "Traffic is vanity. Case acceptance is sanity. We track the journey from first impression to booked appointment." },
    ]}
  />

</Layout>
